{
  "name": "patrocinios-telao",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de gestão de patrocinadores e geração automática de vídeos para telões de eventos",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:porto-feliz": "tsx prisma/seed-porto-feliz-2026.ts",
    "remotion:studio": "remotion studio src/remotion/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "6.19.3",
    "@remotion/bundler": "4.0.500",
    "@remotion/cli": "4.0.500",
    "@remotion/player": "4.0.500",
    "@remotion/renderer": "4.0.500",
    "bcryptjs": "2.4.3",
    "bullmq": "6.5.1",
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "ioredis": "6.0.0",
    "jsdom": "30.1.3",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "remotion": "4.0.500",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.10.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
