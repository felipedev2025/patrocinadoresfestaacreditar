# ---------- Aplicação ----------
APP_URL=http://localhost:3000
# Gere com: openssl rand -base64 48
APP_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-48-bytes-ou-mais
NODE_ENV=development

# ---------- Banco de dados ----------
DATABASE_URL=postgresql://patro:patro@localhost:5432/patrocinios?schema=public

# ---------- Redis / Filas ----------
REDIS_URL=redis://localhost:6379

# ---------- Armazenamento ----------
# local = disco (dev / VPS única) | s3 = qualquer storage compatível com S3 (MinIO, AWS, R2, Wasabi)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=patrocinios
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------- Upload ----------
UPLOAD_MAX_MB=10

# ---------- Worker de renderização ----------
RENDER_CONCURRENCY=1
# Threads de Chrome por render (null = automático). Em VPS de 4 vCPU use 2-3.
RENDER_FRAME_CONCURRENCY=
# Caminho de um Chrome/Chrome Headless Shell já instalado (opcional)
REMOTION_BROWSER_EXECUTABLE=
FFMPEG_PATH=ffmpeg

# ---------- Seed ----------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@acreditar.org
ADMIN_PASSWORD=TroqueEstaSenha!2027
ORG_NAME="Grupo Acreditar"
